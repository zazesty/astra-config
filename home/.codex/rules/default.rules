# Codex execpolicy — mirrors Claude Code ~/.claude/settings.json permissions.
# approval_policy=never makes allow moot; the forbidden rules are the fence.
# Codex has no file-read deny, so secret reads are blocked per reader command (best effort).

# --- deny (Claude: Bash(rm -rf:*), Bash(sudo rm -rf:*)) ---
prefix_rule(pattern=["rm", "-rf"], decision="forbidden", justification="rm -rf is denied on zaz-astra; delete specific paths instead")
prefix_rule(pattern=["rm", "-fr"], decision="forbidden", justification="rm -rf is denied on zaz-astra; delete specific paths instead")
prefix_rule(pattern=["sudo", "rm", "-rf"], decision="forbidden", justification="rm -rf is denied on zaz-astra; delete specific paths instead")
prefix_rule(pattern=["sudo", "rm", "-fr"], decision="forbidden", justification="rm -rf is denied on zaz-astra; delete specific paths instead")

# --- deny secret reads (Claude: Read(/etc/grok-mcp.env), .env*, /root/*.key|crt) ---

prefix_rule(pattern=[["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], "/etc/grok-mcp.env"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=["sudo", ["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], "/etc/grok-mcp.env"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=[["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], ".env"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=["sudo", ["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], ".env"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=[["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], ".env.local"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=["sudo", ["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], ".env.local"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=[["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], "./.env"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=["sudo", ["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], "./.env"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=[["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], "./.env.local"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")
prefix_rule(pattern=["sudo", ["cat", "head", "tail", "less", "more", "grep", "sed", "awk", "strings", "xxd", "base64"], "./.env.local"], decision="forbidden", justification="secret file; use env-presence.sh for presence-only checks")

# --- allow (Claude allow list) ---
