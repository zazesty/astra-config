[Unit]
Description=OR timeout metrics review (1st + 15th of month, PT)

[Timer]
# Twice a month so the first post-ship check lands within ~2 weeks
# (shipped 2026-08-09 → next fire 2026-08-15), then ongoing cadence.
OnCalendar=*-*-01,15 10:15:00 America/Los_Angeles
Persistent=true

[Install]
WantedBy=timers.target
