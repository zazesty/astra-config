# Template for /etc/hermes-finance.env — copy, fill, chmod 600. NEVER commit the filled file.
#   sudo cp /root/astra-config/hermes-finance.env.example /etc/hermes-finance.env
#   sudo chmod 600 /etc/hermes-finance.env
#   sudo nano /etc/hermes-finance.env
#
# Plaid Dashboard → team/app → keys. Trial uses production data for real Items.

# Required for live Link + production Items (PayPal, later Nor Cal)
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional: sandbox secret for Link flow dry-runs without real bank data
# PLAID_SECRET_SANDBOX=

# production | sandbox  (Trial real Items need production)
PLAID_ENV=production

# --- Twilio SMS (budget near/over only) ---
# https://console.twilio.com — Account SID + Auth Token; buy/rent a number.
# TWILIO_FROM = your Twilio number (E.164, e.g. +15551234567)
# TWILIO_TO   = your phone (E.164)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_TO=
