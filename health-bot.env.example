# Copy to /etc/health-bot.env (chmod 600). Never commit real secrets.
HEALTH_BOT_OAUTH_PORT=8768

# From developer.kp.org app credentials (sandbox)
KAISER_SANDBOX_CLIENT_ID=
KAISER_SANDBOX_CLIENT_SECRET=

# Required for live authorize — portal → Application → View Endpoints
KAISER_SANDBOX_FHIR_BASE=
# Optional overrides if discovery fails:
# KAISER_SANDBOX_AUTHORIZE_URL=
# KAISER_SANDBOX_TOKEN_URL=

# Must match portal registration exactly:
KAISER_SANDBOX_REDIRECT_URI=https://zaz-astra.tail5d74e1.ts.net/health-bot/oauth/sandbox/callback.html
