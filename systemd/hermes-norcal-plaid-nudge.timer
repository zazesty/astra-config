[Unit]
Description=Daily 11:00 PT gate — Budget Bot MasterMoney-labels email (every 14d)

[Timer]
# Local timezone (box is America/Los_Angeles). Script enforces ≥14 days between sends.
OnCalendar=*-*-* 11:00:00
Persistent=true
AccuracySec=1min
Unit=hermes-norcal-plaid-nudge.service

[Install]
WantedBy=timers.target
