[Unit]
Description=Budget Bot quarterly tax review email
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/budget-bot
Environment=BUDGET_BOT_STATE=/root/.local/state/budget-bot
EnvironmentFile=-/etc/budget-bot.env
ExecStart=/root/astra-config/agent-jobs/budget-bot-tax-quarterly.sh
