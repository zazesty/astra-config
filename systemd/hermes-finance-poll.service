[Unit]
Description=Budget Bot near-instant poll (sync+review+alerts)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/hermes-finance
Environment=HERMES_FINANCE_STATE=/root/.local/state/hermes-finance
EnvironmentFile=-/etc/hermes-finance.env
ExecStart=/root/astra-config/agent-jobs/hermes-finance-poll.sh
