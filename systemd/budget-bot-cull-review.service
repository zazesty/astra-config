[Unit]
Description=Budget Bot monthly spend cull review email (5th of month)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/budget-bot
Environment=BUDGET_BOT_STATE=/root/.local/state/budget-bot
EnvironmentFile=-/etc/budget-bot.env
ExecStart=/root/astra-config/agent-jobs/budget-bot-cull-review.sh
