[Unit]
# Disabled 2026-10-08 — BMs stable. setup.sh keeps this timer off.
Description=Mon + Thu 08:00 PT — IFX cycle log email (disabled 2026-10-08)

[Timer]
# Box timezone is America/Los_Angeles
OnCalendar=Mon *-*-* 08:00:00
OnCalendar=Thu *-*-* 08:00:00
Persistent=true
AccuracySec=1min
Unit=ifx-cycle-nudge.service

[Install]
WantedBy=timers.target
