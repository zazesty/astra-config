[Unit]
Description=Budget Bot near-instant poll (sync+review+alerts)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/budget-bot
Environment=BUDGET_BOT_STATE=/root/.local/state/budget-bot
EnvironmentFile=-/etc/budget-bot.env
ExecStart=/root/astra-config/agent-jobs/budget-bot-poll.sh
