[Unit]
Description=Budget Bot: weekly NorCal quarantine re-preview (no promote)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/budget-bot
Environment=HOME=/root
Environment=BUDGET_BOT_STATE=/root/.local/state/budget-bot
EnvironmentFile=-/etc/grok-mcp.env
EnvironmentFile=-/etc/budget-bot.env
ExecStart=/root/astra-config/agent-jobs/budget-bot-norcal-quarantine-recheck.sh
