#!/usr/bin/env bash
# Block any commit whose staged content contains a key-shaped string. Defense in
# depth behind .gitignore. Enabled via: git config core.hooksPath .githooks
set -euo pipefail

# Key shapes: OpenAI sk-, xAI xai-, Google AIza..., PEM private keys.
# Require ≥1 digit in sk-/xai- bodies so we don't false-positive on:
#   - "risk-minimization" (substring sk-minimization)
#   - redaction placeholders like "sk-REDACTED" / "xai-REDACTED"
# Real provider keys always include digits.
PATTERN='(sk-[A-Za-z0-9_-]*[0-9][A-Za-z0-9_-]{10,})|(xai-[A-Za-z0-9_-]*[0-9][A-Za-z0-9_-]{10,})|(AIza[A-Za-z0-9_-]{20,})|(-----BEGIN [A-Z ]*PRIVATE KEY-----)'

# Only look at ADDED lines in the staged diff (skip the +++ file headers).
added="$(git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+' || true)"

# Drop known placeholder / docs lines (defense in depth on top of digit rule).
filtered="$(printf '%s\n' "$added" | grep -Ev 'REDACTED|redacted|example\.com|your-api-key' || true)"

if printf '%s' "$filtered" | grep -E "$PATTERN" >/dev/null 2>&1; then
  echo "================================================================" >&2
  echo "pre-commit ABORT: staged content looks like it contains a secret:" >&2
  printf '%s\n' "$filtered" | grep -En "$PATTERN" >&2
  echo "----------------------------------------------------------------" >&2
  echo "Remove the secret (it belongs in /etc/grok-mcp.env, gitignored)." >&2
  echo "False positive? Re-run with --no-verify (NOT recommended)."        >&2
  echo "================================================================" >&2
  exit 1
fi
exit 0
